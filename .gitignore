# not secret - they MUST be versioned, or they exist on one laptop only.
!data/pref-verdicts.json
!data/raak-verdicts.json

# Logs
*.log

# Editor and OS noise
.DS_Store

# Claude Code: machine-local settings and third-party skills stay local.
# Project instructions (CLAUDE.md, DESIGN.md) are versioned.
.claude/settings.local.json
.claude/skills/
