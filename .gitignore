# Dependencies
node_modules/
web/node_modules/

# Build output
web/dist/
dashboard/index.html

# Secrets and local environment
.env*
!.env.example
.session/
.vercel/
api/_data/auth-schema.sql

# Local data, caches and databases
data/*.csv
data/*.json
data/sad/
data/emma.db*
