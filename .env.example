# Copy to .env and fill in. .env is gitignored — never commit real credentials.
EMMA_USER=your_username
EMMA_PASS=your_password

# Optional overrides
EMMA_BASE_URL=https://emmaedoc.no
EMMA_HEADLESS=true          # set to "false" to watch the browser during debugging
EMMA_SLOWMO_MS=0            # add delay (ms) between actions when debugging

